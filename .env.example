# =====================================================================
#  Peatio settings. install.sh copies this file to ".env" and fills in
#  the passwords for you. Edit .env (never this file) and then run:
#      docker compose up -d
#  Lines starting with # are notes and are ignored.
# =====================================================================

# --- Your website ----------------------------------------------------
# The address people type to reach the exchange (no http://, no slash)
URL_HOST=exchange.example.com
# "https" once you have a certificate (install.sh can get one), else "http"
URL_SCHEMA=https

# --- Admin login for the exchange website ------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS

# --- Secrets (install.sh generates these; keep them private) -----------
SECRET_KEY_BASE=
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
RABBITMQ_PASSWORD=
ASSISTANT_DB_PASSWORD=

# --- Database / queue (leave as is when using Docker) ------------------
DB_HOST=db
DB_NAME=peatio_production
DB_USER=peatio
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=peatio
REDIS_URL=redis://redis:6379

# --- Pusher: live price/order-book updates in the browser --------------
# Free account at https://pusher.com -> "Channels" -> create app.
# Copy app_id, key, secret and cluster (e.g. eu) from "App Keys".
PUSHER_APP=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
PUSHER_ENCRYPTED=true

# --- Outgoing e-mail (sign-up confirmations, ticket replies) -----------
# Use the SMTP details from your mail provider (Gmail, Zoho, Mailgun...).
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SUPPORT_MAIL=support@example.com
SYSTEM_MAIL_FROM=no-reply@example.com

# --- Incoming e-mail for the AI assistant (optional) -------------------
# The mailbox the assistant reads so it can draft answers for you.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- AI assistant (control room) ----------------------------------------
# Password for the assistant web page (install.sh generates one)
ASSISTANT_PASSWORD=
# Small model that fits a 2 GB server. With 4 GB+ RAM try qwen2.5:1.5b,
# with 8 GB+ try qwen2.5:3b or llama3.2:3b for better answers.
OLLAMA_MODEL=qwen2.5:0.5b
# Already run Ollama on this server outside Docker? Use:
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
ASSISTANT_PORT=8090
# Your exchange's name, used when the AI writes replies
EXCHANGE_NAME=My Exchange

# --- Background workers --------------------------------------------------
# Which queue workers run. Add "sms_notification" if you set up Twilio,
# "deposit_coin deposit_coin_address withdraw_coin" once a coin node runs.
DAEMON_BINDINGS=matching order_processor trade_executor slave_book market_ticker pusher_market pusher_member email_notification
ENABLE_KLINE=true

# --- SMS 2-factor (optional, Twilio) --------------------------------------
TWILIO_NUMBER=
TWILIO_SID=
TWILIO_TOKEN=
