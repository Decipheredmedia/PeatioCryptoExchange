APP_NAME="Peatio Crypto Exchange"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peatio_production
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@peatio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# RabbitMQ Configuration
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Cryptocurrency Node Configuration
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=
BITCOIN_NETWORK=testnet

ETHEREUM_RPC_HOST=127.0.0.1
ETHEREUM_RPC_PORT=8545
ETHEREUM_NETWORK=ropsten

# Two-Factor Authentication
GOOGLE_2FA_ENABLED=true

# SMS Configuration (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# KYC Configuration
KYC_ENABLED=true
KYC_VERIFICATION_REQUIRED=false

# Trading Configuration
TRADING_FEE_PERCENTAGE=0.2
MINIMUM_TRADE_AMOUNT=0.001
ENABLE_MARKET_ORDERS=true

# Withdrawal Configuration
WITHDRAWAL_DAILY_LIMIT=10000
WITHDRAWAL_REQUIRES_2FA=true
WITHDRAWAL_MIN_CONFIRMATIONS=6

# Deposit Configuration
DEPOSIT_MIN_CONFIRMATIONS=3

# Admin Configuration
ADMIN_EMAIL=admin@peatio.com
ADMIN_2FA_REQUIRED=true

# API Configuration
API_RATE_LIMIT=60
API_RATE_LIMIT_PERIOD=1

# Websocket Configuration
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8080
